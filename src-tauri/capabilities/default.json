{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every app window",
  "windows": [
    "main",
    "win-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "core:window:allow-set-title",
    "fs:allow-read-text-file"
  ]
}
