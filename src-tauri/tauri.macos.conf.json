          "rb",
          "php",
          "java",
          "kt",
          "kts",
          "swift",
          "c",
          "h",
          "cc",
          "cpp",
          "hpp",
          "m",
          "mm",
          "cs",
          "scala",
          "sh",
          "bash",
          "zsh",
          "fish",
          "ps1",
          "sql",
          "yaml",
          "yml",
