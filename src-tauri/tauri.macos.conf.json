        "name": "Source code and text",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.source-code",
          "public.script",
          "public.shell-script",
          "public.plain-text",
          "public.text",
          "public.json",
          "public.xml",
          "public.yaml",
